generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

enum QuoteStatus {
  NEW
  IN_PROGRESS
  WON
  CLOSED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  /// Defaults to the least privilege: invited teammates are editors unless an
  /// admin says otherwise. The seeded owner account is created as ADMIN.
  role         Role       @default(EDITOR)
  /// Deactivated users keep their audit trail but cannot sign in.
  active       Boolean    @default(true)
  lastLoginAt  DateTime?
  /// The invite this user signed up through; null for the seeded admin.
  invitedById  String?
  invitedBy    User?      @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[]     @relation("UserInvites")
  auditLogs    AuditLog[]
  invitesSent  Invite[]   @relation("InviteCreatedBy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// A pending team invitation. The token is stored as a SHA-256 hash — the raw
/// value only ever exists in the invite link, so a database leak cannot be
/// replayed to gain access.
model Invite {
  id          String       @id @default(cuid())
  email       String
  name        String
  role        Role         @default(EDITOR)
  tokenHash   String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdBy   User         @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([email])
  @@index([status, expiresAt])
}

/// Append-only trail of every write performed in the admin area.
model AuditLog {
  id     String @id @default(cuid())
  /// Machine-readable event, e.g. "product.updated" (see lib/audit.ts).
  action String
  /// Entity type touched, e.g. "Product"; null for session events.
  entity String?
  entityId String?
  /// Human-readable summary shown in the audit table.
  summary String
  /// Extra structured context (changed fields, old/new status…).
  meta   Json?
  ip     String?
  /// Actor. Kept as a nullable relation plus a denormalised email/name so the
  /// trail stays readable even if the user row is later deleted.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  userName  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  sku              String?        @unique
  name             String
  modelCode        String?
  shortDescription String
  description      String
  heroImage        String?
  gallery          String[]       @default([])
  priceKz          Decimal?       @db.Decimal(12, 2)
  wattage          Int?
  lumens           Int?
  featured         Boolean        @default(false)
  published        Boolean        @default(true)
  has3dViewer      Boolean        @default(false)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  specs            Spec[]
  quoteRequests    QuoteRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId, published])
}

model Spec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

model CaseStudy {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  client    String
  location  String
  summary   String
  body      String
  heroImage String?
  stats     Json?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteRequest {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  quantity  Int?
  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  status    QuoteStatus @default(NEW)
  createdAt DateTime    @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Editable site-wide branding and copy. Single row, pinned to id "singleton";
/// every column is nullable so an unset field falls back to the code default
/// in src/lib/settings.ts rather than blanking the site.
model SiteSettings {
  id String @id @default("singleton")

  // Hero
  heroEyebrow    String?
  heroHeadline   String?
  heroHighlight  String?
  heroSubtitle   String?
  heroScrollHint String?

  // Brand
  logoUrl    String?
  faviconUrl String?
  themeColor String?

  // Footer
  footerTagline   String?
  footerNif       String?
  footerAddress   String?
  footerPhones    String[] @default([])
  footerEmail     String?
  footerCopyright String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  // Social
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  whatsappUrl  String?

  updatedAt DateTime @updatedAt
}
