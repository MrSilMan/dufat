generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform permissions. Distinct from {@link Cargo}, which is the job role
/// (Caixa, Contabilista…) the award normalises against.
///
/// ADMIN        — Administrador: everything, including confirming the award.
/// GESTOR_RH    — sees every score and runs the ranking, but not site settings.
/// EDITOR       — the catalogue editor role the CMS shipped with.
/// COLABORADOR  — an employee: own sheet and own score only.
enum Role {
  ADMIN
  GESTOR_RH
  EDITOR
  COLABORADOR
}

enum QuoteStatus {
  NEW
  IN_PROGRESS
  WON
  CLOSED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String
  passwordHash       String
  /// Defaults to the least privilege: invited teammates are editors unless an
  /// admin says otherwise. The seeded owner account is created as ADMIN.
  role               Role       @default(EDITOR)
  /// Deactivated users keep their audit trail but cannot sign in.
  active             Boolean    @default(true)
  /// Set when an admin resets a forgotten password. While true every guard
  /// diverts the user to /…/repor, so the temporary password the admin knows
  /// buys access to nothing except the screen that replaces it.
  mustChangePassword Boolean    @default(false)
  lastLoginAt        DateTime?
  /// The invite this user signed up through; null for the seeded admin.
  invitedById        String?
  invitedBy          User?      @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers       User[]     @relation("UserInvites")
  auditLogs          AuditLog[]
  invitesSent        Invite[]   @relation("InviteCreatedBy")

  // ---- Employee record (award module) ----
  /// Job role. Null for accounts that are not scored (a pure catalogue editor).
  cargoId        String?
  cargo          Cargo?        @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  /// Profile photo. Printed on the "Funcionário do Mês" certificate.
  photoUrl       String?
  /// Hire date — the month someone joins is pro-rated from this.
  dataAdmissao   DateTime?     @db.Date
  dataSaida      DateTime?     @db.Date
  /// Contracted working days per week. Null falls back to the cargo's default,
  /// so part-timers are not measured against a full-time expectation.
  diasSemana     Int?

  folhas             FolhaMensal[]
  folhasFechadas     FolhaMensal[] @relation("FolhaFechadaPor")
  atividades         Atividade[]   @relation("AtividadeAutor")
  atividadesRevistas Atividade[]   @relation("AtividadeRevisor")
  ausencias          Ausencia[]
  awardScores        AwardScore[]  @relation("AwardScoreUser")
  awardsGanhos       AwardPeriod[] @relation("AwardVencedor")
  awardsConfirmados  AwardPeriod[] @relation("AwardConfirmadoPor")

  // ---- Daily sales/expense reports ----
  /// Both off by default: the Administrador decides who uses the reports at
  /// all. Someone with neither sees nothing of the feature. Ignored for ADMIN,
  /// who always has full access.
  podeRegistarRelatorios Boolean @default(false)
  /// Read-only view of every colaborador's reports, drafts and history included.
  podeVerRelatorios      Boolean @default(false)

  relatorios            RelatorioDiario[]    @relation("RelatorioAutor")
  relatoriosFinalizados RelatorioDiario[]    @relation("RelatorioFinalizadoPor")
  historicoRelatorios   RelatorioHistorico[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departamentoId])
  @@index([cargoId])
}

/// A pending team invitation. The token is stored as a SHA-256 hash — the raw
/// value only ever exists in the invite link, so a database leak cannot be
/// replayed to gain access.
model Invite {
  id          String       @id @default(cuid())
  email       String
  name        String
  role        Role         @default(EDITOR)
  tokenHash   String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById String
  createdBy   User         @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  /// Employee record captured at invite time and copied onto the User when the
  /// invite is accepted. Filled in here rather than afterwards because an
  /// employee with no cargo is invisible to the award — the ficha has to be
  /// complete from the first day, not whenever someone remembers to finish it.
  cargoId        String?
  cargo          Cargo?        @relation(fields: [cargoId], references: [id], onDelete: SetNull)
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  dataAdmissao   DateTime?     @db.Date
  diasSemana     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, expiresAt])
}

/// Append-only trail of every write performed in the admin area.
model AuditLog {
  id        String   @id @default(cuid())
  /// Machine-readable event, e.g. "product.updated" (see lib/audit.ts).
  action    String
  /// Entity type touched, e.g. "Product"; null for session events.
  entity    String?
  entityId  String?
  /// Human-readable summary shown in the audit table.
  summary   String
  /// Extra structured context (changed fields, old/new status…).
  meta      Json?
  ip        String?
  /// Actor. Kept as a nullable relation plus a denormalised email/name so the
  /// trail stays readable even if the user row is later deleted.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  userName  String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
}

model Product {
  id               String         @id @default(cuid())
  slug             String         @unique
  sku              String?        @unique
  name             String
  modelCode        String?
  shortDescription String
  description      String
  heroImage        String?
  gallery          String[]       @default([])
  priceKz          Decimal?       @db.Decimal(12, 2)
  wattage          Int?
  lumens           Int?
  featured         Boolean        @default(false)
  published        Boolean        @default(true)
  has3dViewer      Boolean        @default(false)
  /// Which 3D model represents this product when has3dViewer is on — a
  /// TurntableVariant (see src/lib/three/showcaseVariants.ts): the complete
  /// street light, one of its parts ("head", "arm", "pole", "base", "door") or
  /// a showcase product. Null falls back to the category's model.
  viewer3dVariant  String?
  /// INVGEST billing-catalog sync (see src/lib/invgest.ts). Null until synced;
  /// items are create-only in INVGEST, so once set these are not re-pushed.
  invgestItemId    String?
  invgestItemCode  String?
  invgestSyncedAt  DateTime?
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  specs            Spec[]
  quoteRequests    QuoteRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([categoryId, published])
}

model Spec {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     String
  label     String
  value     String
  sortOrder Int     @default(0)

  @@index([productId])
}

model CaseStudy {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  client    String
  location  String
  summary   String
  body      String
  heroImage String?
  stats     Json?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuoteRequest {
  id        String      @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  quantity  Int?
  productId String?
  product   Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  status    QuoteStatus @default(NEW)
  createdAt DateTime    @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Editable site-wide branding and copy. Single row, pinned to id "singleton";
/// every column is nullable so an unset field falls back to the code default
/// in src/lib/settings.ts rather than blanking the site.
model SiteSettings {
  id String @id @default("singleton")

  // Hero
  heroEyebrow    String?
  heroHeadline   String?
  heroHighlight  String?
  heroSubtitle   String?
  heroScrollHint String?

  // Brand
  logoUrl    String?
  faviconUrl String?
  themeColor String?

  // Footer
  footerTagline   String?
  footerNif       String?
  footerAddress   String?
  footerPhones    String[] @default([])
  footerEmail     String?
  footerCopyright String?

  // SEO
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  // Social
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  whatsappUrl  String?

  updatedAt DateTime @updatedAt
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Prémio "Funcionário do Mês" — organisation
 */
/**
 * ------------------------------------------------------------------
 */

/// A DUFAT department. Drives the optional one-winner-per-department mode and
/// groups the ranking table.
model Departamento {
  id           String        @id @default(cuid())
  slug         String        @unique
  nome         String
  ativo        Boolean       @default(true)
  sortOrder    Int           @default(0)
  users        User[]
  invites      Invite[]
  awardPeriods AwardPeriod[]
  createdAt    DateTime      @default(now())
}

/// A job role — Caixa, Contabilista, Técnico de Armazém…
///
/// This is the unit of fairness: volume and hours are normalised against the
/// median of the employee's own cargo, because a Caixa logging 200 short
/// counter operations and a Contabilista closing 12 accounts are not
/// comparable on raw totals.
model Cargo {
  id         String   @id @default(cuid())
  slug       String   @unique
  nome       String
  ativo      Boolean  @default(true)
  /// Default contracted days per week for this cargo; User.diasSemana wins.
  diasSemana Int      @default(5)
  users      User[]
  invites    Invite[]
  createdAt  DateTime @default(now())
}

enum TipoAusencia {
  FERIAS
  BAIXA
  LICENCA
  FORMACAO
  OUTRO
}

/// Approved time off. Subtracted from the expected working days so nobody is
/// punished in the consistency score for a month they were signed off for.
model Ausencia {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo      TipoAusencia
  inicio    DateTime     @db.Date
  fim       DateTime     @db.Date
  /// Only approved absences reduce the expected days.
  aprovada  Boolean      @default(false)
  nota      String?
  createdAt DateTime     @default(now())

  @@index([userId, inicio, fim])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Prémio "Funcionário do Mês" — activity record
 */
/**
 * ------------------------------------------------------------------
 */

model CategoriaAtividade {
  id         String      @id @default(cuid())
  slug       String      @unique
  nome       String
  /// Marks a catch-all bucket ("Outro"). More than `limiteOutroPct` of an
  /// employee's validated hours sitting in these costs them points, because a
  /// month of unlabelled work cannot be assessed.
  isOutro    Boolean     @default(false)
  ativo      Boolean     @default(true)
  sortOrder  Int         @default(0)
  atividades Atividade[]
}

enum EstadoFolha {
  ABERTA
  SUBMETIDA
  FECHADA
}

/// One employee's activity sheet for one month. Only a FECHADA sheet with
/// nothing left in question can enter the ranking.
model FolhaMensal {
  id             String      @id @default(cuid())
  /// "YYYY-MM".
  periodo        String
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  estado         EstadoFolha @default(ABERTA)
  /// Submission deadline. Submitting after it costs points.
  prazoSubmissao DateTime?
  submetidaEm    DateTime?
  fechadaEm      DateTime?
  fechadaPorId   String?
  fechadaPor     User?       @relation("FolhaFechadaPor", fields: [fechadaPorId], references: [id], onDelete: SetNull)
  atividades     Atividade[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([userId, periodo])
  @@index([periodo, estado])
}

enum EstadoAtividade {
  RASCUNHO
  SUBMETIDA
  VALIDADA
  EM_JUSTIFICACAO
  JUSTIFICADA
  REJEITADA
}

/// A single logged piece of work.
///
/// `registadaEm` is deliberately separate from `dia`: punctuality is the gap
/// between when work happened and when it was written down, and a month logged
/// in one sitting on the last day should not score like a month logged daily.
model Atividade {
  id          String             @id @default(cuid())
  folhaId     String
  folha       FolhaMensal        @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation("AtividadeAutor", fields: [userId], references: [id], onDelete: Cascade)
  categoriaId String
  categoria   CategoriaAtividade @relation(fields: [categoriaId], references: [id])
  descricao   String
  /// The day the work happened (date only — the sheet is a daily record).
  dia         DateTime           @db.Date
  inicioEm    DateTime
  fimEm       DateTime
  /// Duration in minutes, derived from inicioEm/fimEm on write.
  minutos     Int
  estado      EstadoAtividade    @default(RASCUNHO)

  /// Raised by the anti-gaming pass: an overlap, a bulk-entry day, or an
  /// implausibly short entry. Only costs points once it is actually questioned.
  possivelInconsistencia Boolean @default(false)
  /// Latched the first time the entry is sent back. Quality counts activities
  /// validated *without ever* having been questioned, so clearing the state
  /// later must not clear this.
  jaQuestionada          Boolean @default(false)
  /// Set by the anti-gaming pass when this entry duplicates another (same
  /// cargo-day-category with overlapping times); it is counted once.
  duplicadaDe            String?

  notaRevisao  String?
  /// When the employee actually recorded it.
  registadaEm  DateTime  @default(now())
  revistaEm    DateTime?
  revistaPorId String?
  revistaPor   User?     @relation("AtividadeRevisor", fields: [revistaPorId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([folhaId, dia])
  @@index([userId, dia])
  @@index([estado])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Prémio "Funcionário do Mês" — award
 */
/**
 * ------------------------------------------------------------------
 */

/// Weights, thresholds and switches, all editable by the Administrador.
/// Single row pinned to id "singleton", like SiteSettings.
model AwardSettings {
  id String @id @default("singleton")

  // Component weights — must total 100.
  pesoVolume       Int @default(30)
  pesoHoras        Int @default(25)
  pesoConsistencia Int @default(20)
  pesoQualidade    Int @default(15)
  pesoPontualidade Int @default(10)

  // Penalties, subtracted from the weighted total.
  penalRejeitada      Int @default(5)
  penalInconsistencia Int @default(3)
  penalOutro          Int @default(10)
  penalAtraso         Int @default(5)

  // Thresholds.
  /// Volume/hours are capped at this % of the cargo median so fragmenting work
  /// into many tiny entries cannot run away with the ranking.
  tetoNormalizacaoPct Int @default(150)
  /// "Outro" hours above this % of validated hours trigger penalOutro.
  limiteOutroPct      Int @default(30)
  /// Minimum days with a recorded activity, pro-rated against expected days.
  minDiasAtividade    Int @default(15)
  /// More rejected activities than this and the employee is not eligible.
  maxRejeitadas       Int @default(2)
  /// A cargo with fewer people than this falls back to its historical median.
  minPorCargo         Int @default(3)

  // Switches.
  /// One winner per department instead of one company-wide. Recommended above
  /// roughly 30 people.
  porDepartamento         Boolean @default(false)
  /// Off by default: last period's winner is excluded from the next one, so
  /// the award rotates.
  excluirVencedorAnterior Boolean @default(false)

  updatedAt DateTime @updatedAt
}

enum AwardTipo {
  MENSAL
  ANUAL
}

enum AwardEstado {
  CALCULADO
  CONFIRMADO
}

model AwardPeriod {
  id             String        @id @default(cuid())
  /// "YYYY-MM" for MENSAL, "YYYY" for ANUAL.
  periodo        String
  tipo           AwardTipo     @default(MENSAL)
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)
  /// departamentoId, or "EMPRESA" for a company-wide period. Exists only so the
  /// unique index below actually holds — Postgres treats NULLs as distinct, so
  /// a nullable departamentoId would allow duplicate company-wide periods.
  escopo         String        @default("EMPRESA")
  estado         AwardEstado   @default(CALCULADO)

  vencedorId        String?
  vencedor          User?    @relation("AwardVencedor", fields: [vencedorId], references: [id], onDelete: SetNull)
  pontuacaoVencedor Decimal? @db.Decimal(5, 2)
  /// Who the calculation proposed. Kept separately from vencedorId so an
  /// override stays visible months later.
  propostoId        String?
  /// Required when the confirmed winner is not the top-scoring employee.
  motivoOverride    String?

  confirmadoPorId String?
  confirmadoPor   User?     @relation("AwardConfirmadoPor", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  confirmadoEm    DateTime?
  notaConfirmacao String?

  /// The weights and thresholds this period was scored with, frozen at
  /// calculation time — the published numbers must still add up months later
  /// even after the admin retunes the weights.
  parametros  Json
  calculadoEm DateTime     @default(now())
  scores      AwardScore[]

  @@unique([periodo, tipo, escopo])
  @@index([tipo, periodo])
}

/// Every employee's full breakdown for a period, not just the winner's — the
/// admin has to be able to answer "why not me?" months after the fact.
model AwardScore {
  id                    String      @id @default(cuid())
  awardPeriodId         String
  awardPeriod           AwardPeriod @relation(fields: [awardPeriodId], references: [id], onDelete: Cascade)
  userId                String
  user                  User        @relation("AwardScoreUser", fields: [userId], references: [id], onDelete: Cascade)
  /// 1-based rank among eligible employees; null when not eligible.
  posicao               Int?
  pontuacaoTotal        Decimal     @default(0) @db.Decimal(5, 2)
  /// Per component: raw value, the cargo median it was normalised against, the
  /// normalised 0–1 figure and the weighted points it contributed.
  componentes           Json
  /// Each penalty applied, with its count and the points it cost.
  penalizacoes          Json
  elegivel              Boolean     @default(true)
  motivoInelegibilidade String?

  @@unique([awardPeriodId, userId])
  @@index([awardPeriodId, posicao])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Relatórios diários de vendas e despesas
 */
/**
 * ------------------------------------------------------------------
 */

/// A way money came in or went out — Numerário, Multicaixa, Transferência…
///
/// Managed by the Administrador only. Retired with `ativo`, never deleted: a
/// line that used it must still say how it was paid years later.
model MetodoPagamento {
  id        String             @id @default(cuid())
  /// Unique ignoring case, enforced by the action rather than an index.
  nome      String
  ativo     Boolean            @default(true)
  sortOrder Int                @default(0)
  linhas    LinhaRelatorio[]
  registos  RegistoRelatorio[]
  createdAt DateTime           @default(now())
}

enum EstadoRelatorio {
  RASCUNHO
  FINALIZADO
}

enum TipoLinha {
  VENDA
  DESPESA
}

/// LINHA_* are kept for the history written before records existed, when a
/// line was the unit a colaborador added and edited.
enum AcaoHistoricoRelatorio {
  LINHA_ADICIONADA
  LINHA_EDITADA
  LINHA_APAGADA
  REGISTO_ADICIONADO
  REGISTO_EDITADO
  REGISTO_APAGADO
  FINALIZADO
  REABERTO
}

/// One person's sales and expenses for one calendar day in Luanda.
///
/// Users are `Restrict`ed rather than cascaded: these are financial records,
/// and deleting an account must not take a till's history with it. Accounts are
/// deactivated, not deleted, anyway.
model RelatorioDiario {
  id              String               @id @default(cuid())
  userId          String
  user            User                 @relation("RelatorioAutor", fields: [userId], references: [id], onDelete: Restrict)
  /// The Africa/Luanda calendar day the report covers. Lines inherit it.
  dia             DateTime             @db.Date
  estado          EstadoRelatorio      @default(RASCUNHO)
  /// Bumped on every change to the report or any of its lines. Finalizing
  /// requires the version the client last saw, so a stale tab cannot close a
  /// report it has not seen the latest lines of.
  versao          Int                  @default(1)
  finalizadoEm    DateTime?
  finalizadoPorId String?
  finalizadoPor   User?                @relation("RelatorioFinalizadoPor", fields: [finalizadoPorId], references: [id], onDelete: SetNull)
  registos        RegistoRelatorio[]
  linhas          LinhaRelatorio[]
  historico       RelatorioHistorico[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([userId, dia])
  @@index([dia, estado])
}

/// One sale or expense as it actually happened: who it was for, how it was
/// paid, and the article lines that make it up.
///
/// A record is the unit the colaborador adds, edits and deletes — and the unit
/// that is saved: its lines are written with it, in one transaction, so a sale
/// of three articles can never be half-stored. `versao` guards the record and
/// every line under it at once.
model RegistoRelatorio {
  /// Generated by the browser, like a line's, so a save retried after a
  /// dropped connection finds the record it already wrote.
  id                  String           @id
  relatorioId         String
  relatorio           RelatorioDiario  @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  tipo                TipoLinha
  /// Who the sale was for, or who the expense was paid to. Free text — the
  /// INVGEST client picker fills it, but typing a name is always allowed.
  clienteNome         String?
  clienteNif          String?
  /// The INVGEST client this name was picked from, when it was picked rather
  /// than typed. Not a foreign key: INVGEST is another system.
  clienteInvgestId    String?
  /// The INVGEST document this record was filled in from, as it read at the
  /// time ("FR A1/12"). Reports never issue documents — only read them.
  facturaInvgestId    String?
  facturaCodigo       String?
  metodoPagamentoId   String
  metodoPagamento     MetodoPagamento  @relation(fields: [metodoPagamentoId], references: [id], onDelete: Restrict)
  /// The method's name when the record was saved — see {@link LinhaRelatorio}.
  metodoPagamentoNome String
  nota                String?
  versao              Int              @default(1)
  linhas              LinhaRelatorio[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([relatorioId, createdAt])
}

/// One article on a record: what was sold or bought, how much of it, and at
/// what price.
///
/// `relatorioId`, `tipo` and the payment method are copied down from the
/// record. They are what the totals, the CSV and the printed sheet read, and
/// keeping them here means those four kept working unchanged when records were
/// introduced — the record is the unit that is edited, the line the unit that
/// is counted.
model LinhaRelatorio {
  /// Generated by the browser, so a save retried after a dropped connection
  /// finds the row it already wrote instead of creating a duplicate.
  id                    String           @id
  registoId             String
  registo               RegistoRelatorio @relation(fields: [registoId], references: [id], onDelete: Cascade)
  relatorioId           String
  relatorio             RelatorioDiario  @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  tipo                  TipoLinha
  descricao             String
  /// Thousandths of a unit: 1 unit is 1000, "2,5 m" is 2500. An integer so a
  /// quantity never arrives as 2.4999999999999996.
  quantidadeMil         Int              @default(1000)
  /// Kwanza cêntimos for one unit — taxable when the line carries an IVA rate,
  /// and the price as paid when it does not.
  precoUnitarioCentimos BigInt           @default(0)
  /// IVA in hundredths of a percent (1400 = 14%), added on top of the line's
  /// taxable total. Only lines filled in from an INVGEST document carry one,
  /// so the record adds up to the same cêntimo as the document; a line someone
  /// typed keeps 0, because the price typed is already what was paid.
  taxaIvaCentesimos     Int              @default(0)
  /// quantidade × unit price (+ IVA), in cêntimos, rounded on save. BigInt
  /// because a single municipal order can exceed the ~21 million Kz an Int
  /// would cap it at.
  valorCentimos         BigInt
  /// The INVGEST catalog article this line was picked from, as it read at the
  /// time. Snapshots, not foreign keys: the article may be renamed there.
  artigoInvgestId       String?
  artigoCodigo          String?
  metodoPagamentoId     String
  metodoPagamento       MetodoPagamento  @relation(fields: [metodoPagamentoId], references: [id], onDelete: Restrict)
  /// The method's name when the line was saved, so renaming a method later
  /// does not rewrite what a finalized report says.
  metodoPagamentoNome   String
  /// Position within its record — lines saved together share a timestamp.
  ordem                 Int              @default(0)
  /// Bumped with the record's version; kept so history rows written before
  /// records existed still read back.
  versao                Int              @default(1)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([relatorioId, createdAt])
  @@index([registoId, ordem])
}

/// Append-only history of a report, written in the same transaction as the
/// change it describes — unlike AuditLog, which is best-effort.
model RelatorioHistorico {
  id          String                 @id @default(cuid())
  relatorioId String
  relatorio   RelatorioDiario        @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
  /// No foreign keys: the record or line may since have been deleted.
  registoId   String?
  linhaId     String?
  acao        AcaoHistoricoRelatorio
  /// Line snapshots (amounts as numbers of cêntimos, method name included).
  antes       Json?
  depois      Json?
  /// Reason given when reopening.
  nota        String?
  userId      String?
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String
  createdAt   DateTime               @default(now())

  @@index([relatorioId, createdAt])
}
