# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://dufat:dufat@localhost:5432/dufat?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Secret used to sign admin session JWTs (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-string"
# Credentials for the seeded admin user (used by prisma/seed.ts)
ADMIN_EMAIL="admin@dufat.co.ao"
ADMIN_PASSWORD="dufat-admin-2026"

# --- Email / SMTP (optional) ---
# Used to send team invitations. Leave SMTP_HOST blank to disable sending: the
# admin then gets a copyable invite link in the UI instead, and invites still work.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Dufat, Lda. <no-reply@dufat.co.ao>"

# --- Sentry (optional — leave blank to disable) ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL="info"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
