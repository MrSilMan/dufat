# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://dufat:dufat@localhost:5432/dufat?schema=public"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Secret used to sign admin session JWTs (use a long random string in production)
SESSION_SECRET="change-me-to-a-long-random-string"
# Credentials for the seeded admin user (used by prisma/seed.ts)
ADMIN_EMAIL="admin@dufat.co.ao"
ADMIN_PASSWORD="dufat-admin-2026"

# --- Email / SMTP ---
# Sends team invitations AND inbound lead notifications (quote requests and
# contact messages), plus the acknowledgement the sender receives.
#
# IMPORTANT: with SMTP_HOST blank, nothing is emailed. Invites degrade safely
# (the admin gets a copyable link), but a lead then reaches the database and
# nobody is told about it — set this on any deployment that takes enquiries.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Dufat, Lda. <no-reply@dufat.co.ao>"

# Inbox that receives new leads. Defaults to geral@dufat.co.ao — set this to
# route enquiries somewhere other than the address published on the site.
NOTIFY_EMAIL=""

# --- Sentry (optional — leave blank to disable) ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL="info"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where admin uploads (product images, PDFs) are written. Must NOT be inside
# public/: `next start` snapshots that directory at boot, so files uploaded
# afterwards would 404 until a restart. Defaults to <cwd>/var/uploads and is
# served by src/app/uploads/[...path]/route.ts.
# UPLOAD_DIR="/home/deploy/dufat-app/var/uploads"

# --- INVGEST (e-invoicing / AGT) — optional ---
# Import the INVGEST billing catalog into local products (admin "Importar da
# INVGEST"). Leave INVGEST_API_KEY blank to hide the integration in the admin.
# INVGEST_API_URL may point at invgest.ao directly or at the Cloudflare Worker
# relay (workaround for the ISP null-route); the relay also needs the shared
# INVGEST_PROXY_SECRET that matches the worker's PROXY_SECRET.
INVGEST_API_URL="https://invgest.ao/api/v1"
INVGEST_PROXY_SECRET=""
INVGEST_API_KEY=""
