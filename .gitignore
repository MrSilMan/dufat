# dependencies
/node_modules

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# generated prisma client
/src/generated/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env*.local

# logs
/logs

# uploads (managed content, served by src/app/uploads/[...path]/route.ts)
/var/uploads/*
!/var/uploads/.gitkeep

# database dumps — production data (emails, password hashes, audit trail)
/var/backups/

# raw 3D masters; scripts/optimize-glb.mjs compresses these into
# public/dufat-3d-assets. 29 MB of GLB that git cannot delta-compress.
/asset-masters/

# sentry
.sentryclirc

# typescript
*.tsbuildinfo
